# ============================================
# Link2Global - Docker 环境变量示例
# ============================================

# 复制此文件为 .env 并填入真实值

# LLM API (必需)
COZE_API_KEY=your_coze_api_key_here

# 对象存储 (必需)
COZE_BUCKET_ENDPOINT_URL=https://your-bucket-endpoint.example.com
COZE_BUCKET_NAME=your-bucket-name

# TikTok Shop API (发布到 TikTok 必需)
TIKTOK_APP_ID=your_tiktok_app_id
TIKTOK_APP_SECRET=your_tiktok_app_secret

# Shopee API (发布到 Shopee 必需)
SHOPEE_PARTNER_ID=your_shopee_partner_id
SHOPEE_PARTNER_KEY=your_shopee_partner_key

# 项目域名 (必需，用于 OAuth 回调)
COZE_PROJECT_DOMAIN_DEFAULT=https://your-domain.com
